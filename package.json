{
  "name": "gdrive-vault-sync",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian plugin: two-way vault sync with Google Drive",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "make-test-vault": "node scripts/make-test-vault.mjs",
    "make-second-vault": "node scripts/make-second-vault.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/spark-md5": "^3.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  }
}
